# Replit provides DATABASE_URL for the configured PostgreSQL database.
DATABASE_URL=

# Clerk keys are provisioned by Replit Clerk Auth; never commit real key values.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=

# Set the verified primary email that is allowed to claim the one-time admin role.
ADMIN_EMAIL=

# Public canonical site origin; set this only after the app has a production URL.
VITE_PUBLIC_SITE_URL=

# Planned payment integration; checkout is not active until configured and implemented.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Planned transactional email; notifications are not active until configured and implemented.
EMAIL_PROVIDER_API_KEY=
