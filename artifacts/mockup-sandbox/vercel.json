{
  "buildCommand": "pnpm --filter @workspace/travel-platform build && node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.cpSync('../travel-platform/dist/public','dist',{recursive:true});\"",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
